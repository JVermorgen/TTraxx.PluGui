<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>TTraxx.PluGui.NPlug</PackageId>
    <Description>Helper contract for NPlug implementations of the TTraxx.PluGui GUI library.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>PluGui_250x250.png</PackageIcon>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../assets/PluGui_250x250.png" Pack="true" PackagePath="\" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NPlug" Version="0.5.0.380" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TTraxx.PluGui.Gui\TTraxx.PluGui.Gui.csproj" />
  </ItemGroup>

  <!-- Public API baseline: RS0016 flags any public member missing from PublicAPI.*.txt, so an
       accidental breaking change to the package surface fails the build instead of shipping.
       The package's own .targets adds those two files as AdditionalFiles when they exist, so
       listing them here as well makes dotnet watch report them as duplicate source files. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.24508.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
